PORT=3000
# Who receives submissions (comma-separated). MAIL_TO is the fallback if a specific list isn't set.
MAIL_TO=info@bc-compliance.co.uk
MAIL_TO_QUOTES=
MAIL_TO_APPOINTMENTS=
MAIL_FROM="Blu Chip Compliance <forms@bc-compliance.co.uk>"

# SMTP account used to send (Microsoft 365 / Google Workspace / your host)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Send the submitter an automatic "we've received it" email
SEND_CONFIRMATION=true
